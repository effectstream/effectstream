{
  "name": "@e2e/node",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "./src/main.ts",
  "exports": {
    ".": "./src/main.ts",
    "./custom-primitive": "./src/custom-primitive.ts"
  },
  "scripts": {
    "check": "bun run --bun src/main.ts",
    "check:testnet": "bun run --bun src/main.testnet.ts",
    "node:start:quickstart": "bun run --inspect --bun src/main.ts",
    "node:start:e2e": "bun run --inspect --bun src/main.ts",
    "node:start:testnet": "bun run --inspect --bun src/main.testnet.ts",
    "quickstart": "bun run --filter @effectstream/tui clean && EFFECTSTREAM_ENV=quickstart NODE_ENV=development bun run --bun scripts/start.quickstart.ts",
    "e2e": "EFFECTSTREAM_ENV=e2e bun run --bun scripts/start.e2e.ts",
    "testnet": "EFFECTSTREAM_ENV=testnet bun run --bun scripts/start.testnet.ts"
  },
  "dependencies": {
    "@deno/vite-plugin": "^1.0.4",
