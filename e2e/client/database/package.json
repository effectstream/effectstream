{
  "name": "@e2e/database",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "./src/mod.ts",
  "exports": {
    ".": "./src/mod.ts"
  },
  "scripts": {
    "_pgtyped:my-sql": "bun run @effectstream/db/db-wait && bun run @effectstream/db/apply-migrations && bun run --bun ./sql-to-ts.ts && pgtyped -c ./pgtypedconfig.json",
    "pgtyped:update": "concurrently --raw --kill-others \"bun run @effectstream/db/db-up\" \"bun run _pgtyped:my-sql\""
  },
  "dependencies": {
    "@effectstream/db": "workspace:*",
    "@pgtyped/runtime": "2.4.2",
    "pg": "^8.14.0",
    "effection": "3.5.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
