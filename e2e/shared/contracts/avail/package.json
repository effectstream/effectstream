{
  "name": "@e2e/avail-contracts",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "./read-app.ts",
  "exports": {
    ".": "./read-app.ts"
  },
  "scripts": {
    "avail-node:start": "bun run --filter @effectstream/npm-avail-node start --dev --rpc-port 9955 --no-telemetry",
    "avail-node:wait": "wait-on tcp:9955",
    "avail-light-client:deploy": "bun run avail-light-client:clean && bun run ./deploy.ts",
    "avail-light-client:start": "bun run --filter @effectstream/npm-avail-light-client start --config ./config.yml --app-id $AVAIL_APP_ID",
    "avail-light-client:wait": "wait-on tcp:7007",
    "avail-light-client:clean": "rm -rf ./avail_path"
  },
  "dependencies": {
    "@effectstream/avail-contracts": "workspace:*",
    "avail-js-sdk": "^0.4.2"
  },
  "devDependencies": {
    "wait-on": "^7.2.0"
  }
}
