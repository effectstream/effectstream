{
  "name": "@e2e/midnight-contract-eip-20",
  "exports": {
    ".": "./src/_index.ts",
    "./witnesses": "./src/witnesses.ts",
    "./contract": "./src/managed/simpletoken/contract/index.cjs"
  },
  "tasks": {
    "compact": "compact compile src/simpletoken.compact src/managed/simpletoken && deno task convert:js",
    "convert:js": "deno run -A convert-js.ts src/managed/simpletoken/contract/index.cjs src/managed/simpletoken/contract/index.ts",
    "contract:compile": "deno task compact"
  },
  "imports": {
    "vitest": "npm:vitest@^3.2.4",
    "@midnight-ntwrk/compact-runtime": "npm:@midnight-ntwrk/compact-runtime@^0.9.0"
  }
}