{
  "name": "@e2e/evm-contracts",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "exports": "./mod.ts",
  "scripts": {
    "swap:remappings:forge": "bun -e 'await import(\"@effectstream/evm-hardhat/remappings-forge\")'",
    "swap:remappings:hardhat": "bun -e 'await import(\"@effectstream/evm-hardhat/remappings-hardhat\")'",
    "check": "echo 'check'",
    "build:mod": "(bun run deploy:standalone || true) && bun -e 'await import(\"@effectstream/evm-hardhat/builder\")'",
    "build:clean": "rm -rf build || true",
    "build:forge": "bun run swap:remappings:forge && forge build",
    "build:hardhat": "bun run swap:remappings:hardhat && bunx hardhat compile",
    "build": "bun run build:forge && bun run build:hardhat",
    "contract:compile": "bun run build:mod",
    "deploy:clean": "((rm -rf ignition/deployments/chain-31337); (rm -rf ignition/deployments/chain-31338)) || true",
    "deploy:standalone": "bun run build && (((bun run chain:start) &) && (bun run chain:wait) && (bun run deploy) && bun run chain:stop) || true",
    "deploy:testnet": "bun run build && bun deploy.testnet.ts",
    "deploy": "bun run deploy:clean && bun deploy.ts",
    "chain:start": "bunx hardhat node",
    "chain:stop": "kill -9 $(lsof -ti tcp:8545) || true",
    "chain:wait": "bunx hardhat node wait"
  },
  "dependencies": {
    "@nomicfoundation/ignition-core": "3.0.2",
    "@openzeppelin/contracts": "5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "@effectstream/evm-contracts": "file:./../../../../packages/chains/evm-contracts",
    "@wagmi/cli": "2.3.1",
    "@nomicfoundation/hardhat-ignition-viem": "3.0.2",
    "@nomicfoundation/hardhat-ignition": "npm:@nomicfoundation/hardhat-ignition-viem@3.0.2",
    "@nomicfoundation/hardhat-viem": "3.0.0",
    "ws": "8.18.1",
    "@nomicfoundation/hardhat-errors": "3.0.1",
    "@nomicfoundation/hardhat-utils": "3.0.0"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "@opentelemetry/sdk-node": "0.56.0",
    "hardhat": "3.0.4",
    "wait-on": "8.0.3"
  }
}
