{
  "name": "bun-zswap-da",
  "private": true,
  "workspaces": [
    "packages/**/*",
    "e2e"
  ],
  "scripts": {
    "dev": "bun run e2e/dev.ts",
    "dev:celestia-mainnet": "bun --env-file=../.env.mainnet run e2e/dev.ts -- --celestia-mainnet",
    "node:dev": "bun run --filter @zswap-da/node dev",
    "frontend": "bun run --filter @zswap-da/frontend dev",
    "e2e": "bun run e2e/run-tests.ts"
  }
}
