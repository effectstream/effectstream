{
  "version": "0.3.62",
  "workspace": [
    "./packages/**/*",
    "./e2e/**/*",
    "./docs/**/*"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno task -f @e2e/node check"
  },
  "imports": {
    "ignore": "npm:ignore@7.0.5",
    "isbinaryfile": "npm:isbinaryfile"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-this-alias",
        "require-yield",
        "no-explicit-any",
        "ban-types",
        "no-unused-vars",
        "no-slow-types"
      ]
    }
  }
}