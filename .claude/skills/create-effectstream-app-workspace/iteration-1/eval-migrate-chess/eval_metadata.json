{
  "eval_id": 2,
  "eval_name": "migrate-paimaexample-chess",
  "prompt": "Migrate old @paimaexample/* chess template to effectstream-v2. Provide ordered file-level plan covering renames, flattening, deletions, inlining game logic, workspace+scripts changes, new files. Save plan to /tmp/eval-runs/iter-1/eval-migrate-chess/{with,without}/migration-plan.md.",
  "assertions": [
    {
      "id": "plan_paimaexample_rename",
      "text": "Plan mentions @paimaexample/* → @effectstream/* rename (with table or list)",
      "check_type": "grep",
      "file": "migration-plan.md",
      "pattern": "@paimaexample[\\s\\S]{0,200}@effectstream"
    },
    {
      "id": "plan_paimastm_rename",
      "text": "Plan covers PaimaSTM → Stm rename",
      "check_type": "grep",
      "file": "migration-plan.md",
      "pattern": "PaimaSTM[\\s\\S]{0,100}Stm"
    },
    {
      "id": "plan_l2_contract_rename",
      "text": "Plan covers PaimaL2Contract → EffectstreamL2Contract Solidity rename",
      "check_type": "grep",
      "file": "migration-plan.md",
      "pattern": "PaimaL2Contract[\\s\\S]{0,200}EffectstreamL2Contract"
    },
    {
      "id": "plan_flatten_client_node",
      "text": "Plan covers flattening packages/client/node → packages/node",
      "check_type": "grep",
      "file": "migration-plan.md",
      "pattern": "packages/client/node[\\s\\S]{0,200}packages/node"
    },
    {
      "id": "plan_delete_game_logic",
      "text": "Plan tells reader to delete packages/shared/game-logic entirely",
      "check_type": "grep_any",
      "file": "migration-plan.md",
      "patterns": ["(?i)delete[^\\n]{0,200}game-logic", "(?i)game-logic[^\\n]{0,200}(?:delete|remove)", "(?i)remove[^\\n]{0,200}game-logic"]
    },
    {
      "id": "plan_executor_removal",
      "text": "Plan covers removing round_executor / match_executor / tick abstraction",
      "check_type": "grep_any",
      "file": "migration-plan.md",
      "patterns": ["round_executor", "match_executor", "executor abstraction", "tick"]
    },
    {
      "id": "plan_inline_game_logic",
      "text": "Plan tells the user to inline pure helpers (chess-logic, validation) into packages/node/",
      "check_type": "grep_any",
      "file": "migration-plan.md",
      "patterns": ["(?i)inline", "(?i)move .* into packages/node", "(?i)merge .* into.*state-machine"]
    },
    {
      "id": "plan_remove_tuple_pattern",
      "text": "Plan addresses removing the [PreparedQuery, params] tuple pattern (yield World.resolve directly)",
      "check_type": "grep_any",
      "file": "migration-plan.md",
      "patterns": ["PreparedQuery,\\s*params", "tuple pattern", "SQLUpdate"]
    },
    {
      "id": "plan_start_dev_ts_root",
      "text": "Plan creates start.dev.ts at project root with export default OrchestratorConfig",
      "check_type": "grep_all",
      "file": "migration-plan.md",
      "patterns": ["start\\.dev\\.ts", "(?i)root|project root", "(?i)export default|OrchestratorConfig"]
    },
    {
      "id": "plan_split_config_files",
      "text": "Plan splits localhostConfig into config.dev.ts + config.mainnet.ts",
      "check_type": "grep_all",
      "file": "migration-plan.md",
      "patterns": ["config\\.dev\\.ts", "config\\.mainnet\\.ts"]
    },
    {
      "id": "plan_split_main_files",
      "text": "Plan splits main.ts into main.dev.ts + main.mainnet.ts",
      "check_type": "grep_all",
      "file": "migration-plan.md",
      "patterns": ["main\\.dev\\.ts", "main\\.mainnet\\.ts"]
    },
    {
      "id": "plan_workspaces_change",
      "text": "Plan updates package.json workspaces to packages/*",
      "check_type": "grep_any",
      "file": "migration-plan.md",
      "patterns": ["\"workspaces\"\\s*:\\s*\\[\\s*\"packages/\\*\"", "workspaces.*packages/\\*"]
    },
    {
      "id": "plan_effectstream_default",
      "text": "Plan adds effectstream.default field to package.json",
      "check_type": "grep",
      "file": "migration-plan.md",
      "pattern": "effectstream[\\s\\S]{0,80}default"
    },
    {
      "id": "plan_add_tests_package",
      "text": "Plan adds packages/tests/ (didn't exist in old layout)",
      "check_type": "grep_any",
      "file": "migration-plan.md",
      "patterns": ["packages/tests/?", "test suite", "Phase A.*Phase B"]
    },
    {
      "id": "plan_add_dockerfile",
      "text": "Plan adds Dockerfile (didn't exist in old layout)",
      "check_type": "grep",
      "file": "migration-plan.md",
      "pattern": "Dockerfile"
    },
    {
      "id": "plan_replace_oak",
      "text": "Plan replaces Oak (frontend server) with Fastify + @fastify/static",
      "check_type": "grep_all",
      "file": "migration-plan.md",
      "patterns": ["Oak", "Fastify"]
    },
    {
      "id": "plan_remove_ts_rest",
      "text": "Plan removes @ts-rest in favor of plain Fastify routes",
      "check_type": "grep",
      "file": "migration-plan.md",
      "pattern": "ts-rest"
    },
    {
      "id": "plan_phantom_midnight_dep",
      "text": "Plan mentions the @midnight-ntwrk/wallet-sdk-address-format phantom dependency",
      "check_type": "grep",
      "file": "migration-plan.md",
      "pattern": "wallet-sdk-address-format"
    },
    {
      "id": "plan_docker_symlink_workaround",
      "text": "Plan mentions the Dockerfile workspace-symlink workaround for Bun on Linux",
      "check_type": "grep_any",
      "file": "migration-plan.md",
      "patterns": ["symlink", "workspace.*Linux", "Bun.*Linux"]
    }
  ]
}
