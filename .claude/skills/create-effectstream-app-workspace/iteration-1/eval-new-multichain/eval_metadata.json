{
  "eval_id": 1,
  "eval_name": "new-multichain-evm-midnight",
  "prompt": "New Effectstream template `mint-and-mint` targeting EVM (Hardhat/Arbitrum) AND Midnight. Batcher (EVM), Vite/React frontend with NftMinted event, full A/B/C tests inc. Playwright, mainnet configs, Dockerfile. Need: start.dev.ts, root package.json, batcher files, Dockerfile, vite.config.ts, packages/shared/app-events.ts. Save to /tmp/eval-runs/iter-1/eval-new-multichain/{with,without}/template/.",
  "assertions": [
    {
      "id": "root_workspaces_nested_midnight",
      "text": "Root package.json lists nested midnight contract workspace explicitly (packages/* doesn't recurse)",
      "check_type": "grep",
      "file": "package.json",
      "pattern": "packages/contracts-midnight/[A-Za-z0-9_-]+"
    },
    {
      "id": "root_phantom_midnight_dep",
      "text": "Root package.json includes @midnight-ntwrk/wallet-sdk-address-format phantom dependency",
      "check_type": "grep",
      "file": "package.json",
      "pattern": "@midnight-ntwrk/wallet-sdk-address-format"
    },
    {
      "id": "root_effectstream_default",
      "text": "Root package.json has effectstream.default",
      "check_type": "grep",
      "file": "package.json",
      "pattern": "\"effectstream\"[\\s\\S]{0,200}\"default\""
    },
    {
      "id": "start_dev_launches_both",
      "text": "start.dev.ts launches both EVM and Midnight",
      "check_type": "grep_all",
      "file": "start.dev.ts",
      "patterns": ["launchEvm", "launchMidnight"]
    },
    {
      "id": "start_dev_uses_cwd",
      "text": "start.dev.ts uses { cwd } for both launchers (NOT resolveFrom as an actual argument)",
      "check_type": "grep_absent",
      "file": "start.dev.ts",
      "pattern": "resolveFrom\\s*:"
    },
    {
      "id": "midnight_storage_password_complexity",
      "text": "MIDNIGHT_STORAGE_PASSWORD in start.dev.ts passes 3-of-4 complexity (upper, lower, digit, special)",
      "check_type": "regex_complex_password",
      "file": "start.dev.ts"
    },
    {
      "id": "batcher_factory_exists",
      "text": "batcher factory file exists with createEffectstreamL2Adapter export",
      "check_type": "grep",
      "file": "packages/batcher/effectstream-l2.ts",
      "pattern": "createEffectstreamL2Adapter|EffectstreamL2DefaultAdapter"
    },
    {
      "id": "batcher_dev_namespace",
      "text": "batcher.dev.ts has BatcherConfig with namespace field",
      "check_type": "grep",
      "file": "packages/batcher/batcher.dev.ts",
      "pattern": "namespace\\s*:"
    },
    {
      "id": "batcher_mainnet_env_validation",
      "text": "batcher.mainnet.ts validates env vars (throws if missing)",
      "check_type": "grep_all",
      "file": "packages/batcher/batcher.mainnet.ts",
      "patterns": ["process\\.env", "throw\\s+new\\s+Error"]
    },
    {
      "id": "vite_no_top_level_await_plugin",
      "text": "vite.config.ts does NOT actually import vite-plugin-top-level-await",
      "check_type": "grep_absent",
      "file": "packages/frontend/vite.config.ts",
      "pattern": "(?:from|require\\()\\s*['\"]vite-plugin-top-level-await['\"]"
    },
    {
      "id": "vite_node_fetch_shim",
      "text": "vite.config.ts aliases node-fetch to a shim (or has equivalent fix)",
      "check_type": "grep_any",
      "file": "packages/frontend/vite.config.ts",
      "patterns": ["\"node-fetch\"\\s*:", "node-fetch.*shim", "native-fetch-shim"]
    },
    {
      "id": "vite_stream_web_fix",
      "text": "vite.config.ts handles stream/web polyfill (fix-stream-web plugin or equivalent)",
      "check_type": "grep_any",
      "file": "packages/frontend/vite.config.ts",
      "patterns": ["stream/web", "stream-web-shim", "fix-stream-web"]
    },
    {
      "id": "dockerfile_compact",
      "text": "Dockerfile installs the Compact compiler",
      "check_type": "grep_any",
      "file": "Dockerfile",
      "patterns": ["compact-installer", "compact\\s+update"]
    },
    {
      "id": "dockerfile_xz_utils",
      "text": "Dockerfile installs xz-utils (required for Midnight)",
      "check_type": "grep",
      "file": "Dockerfile",
      "pattern": "xz-utils"
    },
    {
      "id": "dockerfile_foundry",
      "text": "Dockerfile installs Foundry/forge for EVM",
      "check_type": "grep_any",
      "file": "Dockerfile",
      "patterns": ["foundry", "forge"]
    },
    {
      "id": "dockerfile_workspace_symlink",
      "text": "Dockerfile includes workspace-symlink workaround after bun install",
      "check_type": "grep_any",
      "file": "Dockerfile",
      "patterns": ["Bun\\.Glob", "symlinkSync", "ln\\s+-sfn.*node_modules"]
    },
    {
      "id": "app_events_registerEvents",
      "text": "packages/shared/app-events.ts uses registerEvents + genEvent + indexed fields",
      "check_type": "grep_all",
      "file": "packages/shared/app-events.ts",
      "patterns": ["registerEvents", "genEvent", "indexed\\s*:\\s*true"]
    },
    {
      "id": "app_events_NftMinted",
      "text": "packages/shared/app-events.ts declares an NftMinted (or similarly named) event",
      "check_type": "grep",
      "file": "packages/shared/app-events.ts",
      "pattern": "(?i)NftMinted|Nft_Minted|MintedNft"
    }
  ]
}
