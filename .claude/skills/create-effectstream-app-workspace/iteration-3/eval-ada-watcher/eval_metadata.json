{
  "eval_id": 0,
  "eval_name": "ada-watcher",
  "prompt": "Cardano-only Effectstream template `ada-watcher` that watches a configurable Cardano address (the user's wallet) and stores every incoming ADA transfer in the DB. Includes a Lucid-based React/Vite frontend that lists the indexed transfers. Generate a fresh dev wallet for the watched address as part of setup. Save to /tmp/eval-runs/iter-3/eval-ada-watcher/with/template/. Goal: `bun install && bun run build:pgtypes && bun run test` exits 0.",
  "runtime_check": "auto",
  "assertions": [
    {
      "id": "root_workspaces",
      "text": "Root package.json declares packages/* workspaces",
      "check_type": "grep",
      "file": "package.json",
      "pattern": "\"workspaces\"\\s*:\\s*\\[\\s*\"packages/\\*\""
    },
    {
      "id": "root_test_script",
      "text": "Root package.json has \"test\" script",
      "check_type": "grep",
      "file": "package.json",
      "pattern": "\"test\"\\s*:\\s*\"bun"
    },
    {
      "id": "root_build_pgtypes",
      "text": "Root package.json's build:pgtypes script invokes orchestrator stop first",
      "check_type": "grep",
      "file": "package.json",
      "pattern": "orchestrator\\s+stop[\\s\\S]{0,80}pgtyped:update"
    },
    {
      "id": "real_version",
      "text": "No <latest> placeholders in root package.json",
      "check_type": "grep_absent",
      "file": "package.json",
      "pattern": "\"<latest>\""
    },
    {
      "id": "phantom_dep",
      "text": "Root package.json includes @midnight-ntwrk/wallet-sdk-address-format phantom dep",
      "check_type": "grep",
      "file": "package.json",
      "pattern": "@midnight-ntwrk/wallet-sdk-address-format"
    },
    {
      "id": "start_dev_cardano",
      "text": "start.dev.ts calls launchCardano",
      "check_type": "grep",
      "file": "start.dev.ts",
      "pattern": "launchCardano"
    },
    {
      "id": "start_dev_no_resolvefrom",
      "text": "start.dev.ts does NOT use resolveFrom: as an actual argument",
      "check_type": "grep_absent",
      "file": "start.dev.ts",
      "pattern": "resolveFrom\\s*:"
    },
    {
      "id": "start_dev_filter_submit_tx",
      "text": "start.dev.ts filters out CARDANO_SUBMIT_TX in dev mode",
      "check_type": "grep_any",
      "file": "start.dev.ts",
      "patterns": ["CARDANO_SUBMIT_TX", "submit-tx"]
    },
    {
      "id": "config_cardano_sync_protocol",
      "text": "config.dev.ts uses CARDANO_UTXORPC_PARALLEL or CARDANO_CARP_PARALLEL",
      "check_type": "grep_any",
      "file": "packages/node/config.dev.ts",
      "patterns": ["CARDANO_UTXORPC_PARALLEL", "CARDANO_CARP_PARALLEL"]
    },
    {
      "id": "config_cardano_primitive",
      "text": "config.dev.ts uses a Cardano transfer primitive",
      "check_type": "grep_any",
      "file": "packages/node/config.dev.ts",
      "patterns": ["PrimitiveTypeCardanoTransfer", "PrimitiveTypeUtxorpcGeneric", "CardanoTransfer"]
    },
    {
      "id": "grammar_cardano_transfer",
      "text": "grammar.ts uses cardanoTransfer (or utxorpcGeneric) builtin",
      "check_type": "grep_any",
      "file": "packages/node/grammar.ts",
      "patterns": ["cardanoTransfer", "utxorpcGeneric"]
    },
    {
      "id": "stm_uses_world_resolve",
      "text": "state-machine.ts uses World.resolve to insert transfers",
      "check_type": "grep_all",
      "file": "packages/node/state-machine.ts",
      "patterns": ["World\\.resolve", "addStateTransition"]
    },
    {
      "id": "node_sibling_database_workspace",
      "text": "packages/node/package.json declares database sibling as workspace:*",
      "check_type": "grep",
      "file": "packages/node/package.json",
      "pattern": "\"@ada-watcher/database\"\\s*:\\s*\"workspace:\\*\""
    },
    {
      "id": "database_init_sql",
      "text": "packages/database/migrations/000-init.sql creates a transfers (or similar) table",
      "check_type": "grep_any",
      "file": "packages/database/migrations/000-init.sql",
      "patterns": ["CREATE TABLE.*transfer", "CREATE TABLE.*incoming", "address.*TEXT", "amount"]
    },
    {
      "id": "tests_run_tests_exists",
      "text": "packages/tests/run-tests.ts exists",
      "check_type": "file_exists",
      "file": "packages/tests/run-tests.ts"
    },
    {
      "id": "tests_start_test_exists",
      "text": "packages/tests/start.test.ts exists",
      "check_type": "file_exists",
      "file": "packages/tests/start.test.ts"
    },
    {
      "id": "tests_chain_ready",
      "text": "packages/tests/infra/chain-ready.test.ts checks YACI or Dolos health",
      "check_type": "grep_any",
      "file": "packages/tests/infra/chain-ready.test.ts",
      "patterns": ["10000", "3000", "50051", "yaci", "dolos", "Blockfrost"]
    },
    {
      "id": "tests_phase_b_transfer",
      "text": "Phase B test sends ADA and asserts a DB row",
      "check_type": "grep_any",
      "file": "packages/tests/stm/transfer.test.ts",
      "patterns": ["assertSQL", "Lucid", "topup", "submitTx", "adaAmount"]
    },
    {
      "id": "frontend_lucid",
      "text": "Frontend uses Lucid Evolution",
      "check_type": "grep_any",
      "file": "packages/frontend/package.json",
      "patterns": ["@lucid-evolution/lucid", "@lucid-evolution/provider"]
    },
    {
      "id": "stale_port_kill_in_tests",
      "text": "run-tests.ts kills stale ports before starting (no shared state)",
      "check_type": "grep_any",
      "file": "packages/tests/run-tests.ts",
      "patterns": ["lsof.*kill", "orchestrator.*stop", "kill.*4747"]
    },
    {
      "id": "no_hand_written_queries_ts",
      "text": "If sql/queries.queries.ts exists, it should look generated (no fabricated locs without IR JSON)",
      "check_type": "grep",
      "file": "packages/database/sql/queries.queries.ts",
      "pattern": "PreparedQuery"
    }
  ]
}
