{
  "name": "@example/evm-contracts",
  "version": "0.3.0",
  "exports": {
    // TODO: how these actually will work will depend on the hardhat v3 viem plugin
    //       See https://github.com/NomicFoundation/hardhat/issues/5978
    // "./abi/*": "./build/abi/*",
    // "./contracts/*": "./build/contracts/*",
    // "./companion-abi/*": "./build/companion-abi/*"
  },
  "imports": {
    "hardhat": "npm:hardhat@3.0.0-next.3",
    "@nomicfoundation/hardhat-viem": "npm:@nomicfoundation/hardhat-viem@3.0.0-next.3",
    "ws": "npm:ws@8.18.1", // required for https://github.com/NomicFoundation/hardhat/issues/6472
    "@nomicfoundation/hardhat-errors": "npm:@nomicfoundation/hardhat-errors@3.0.0-next.3", // required for https://github.com/NomicFoundation/hardhat/issues/6472
    "@nomicfoundation/hardhat-utils": "npm:@nomicfoundation/hardhat-utils@3.0.0-next.3", // required for https://github.com/NomicFoundation/hardhat/issues/6472
    "@nomicfoundation/hardhat-ignition": "npm:@nomicfoundation/hardhat-ignition@3.0.0-next.3",
    "@nomicfoundation/hardhat-ignition-viem": "npm:@nomicfoundation/hardhat-ignition-viem@3.0.0-next.3",
    "viem": "npm:viem@2.23.10"
  },
  "tasks": {
    // deno doesn't support installing packages from Github (https://github.com/denoland/deno/issues/18478)
    // we can't easily use file: dependency as that isn't supported either (https://github.com/denoland/deno/issues/18474)
    // so instead we symlink to a local copy of the project
    "link:forge": "bash -c 'if ! [ -L ../../../node_modules/forge-std ]; then ln -s ../forge-std ../../../node_modules/forge-std; fi'",

    // TODO: update `hardhat docgen` to Hardhat v3
    // note: this should be `deno run hardhat3 compile`, but Deno doesn't like that so we have to use the full name
    "build:contracts": "forge build && deno run -A npm:hardhat@3.0.0-next.3 compile",
    "build:publish": "./prepare.sh",
    "prebuild": "rm -rf ./build",
    "build": "deno task prebuild && deno task build:contracts && deno task build:publish",

    "clean": "rm -rf ./artifacts && rm -rf ./cache && rm -rf ./build",
    "test": "forge test",

    // TODO: how to integrate Prettier plugin with deno and/or forge?
    "prettier": "prettier --write '**/*.{sol,js,ts}' --ignore-path .gitignore",

    // note: this should be `deno run hardhat3 compile`, but Deno doesn't like that so we have to use the full name
    "chain:start": "deno run -A npm:hardhat@3.0.0-next.3 node",
    "chain:wait": "deno run -A npm:hardhat@3.0.0-next.3 node wait"
  }
}
