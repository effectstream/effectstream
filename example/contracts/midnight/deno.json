{
    "name": "@example/midnight-contracts",
    "version": "0.3.0",
    "exports": {},
    "tasks": {
        "midnight-node:start": "CFG_PRESET=dev deno run -A --unstable-detect-cjs --node-modules-dir ../../../packages/binaries/midnight-node/index.js --dev --rpc-port 9955",
        "midnight-node:wait": "wait-on tcp:9955",
        "midnight-indexer:clean": "rm -rf ../../../packages/binaries/midnight-indexer/indexer-standalone/data/indexer.sqlite",
        "midnight-indexer:start": "deno task midnight-indexer:clean && APP__APPLICATION__BLOCKS_BUFFER=60 APP__APPLICATION__CAUGHT_UP_MAX_DISTANCE=60 APP__APPLICATION__CAUGHT_UP_LEEWAY=30 LEDGER_NETWORK_ID=\"Undeployed\" SUBSTRATE_NODE_WS_URL=\"ws://localhost:9955\" APP__INFRA__SECRET=\"A5F07FCAC914A181EC0998CCCA68312DA5F07FCAC914A181EC0998CCCA68312D\" FEATURES_WALLET_ENABLED=\"true\" APP__INFRA__NODE__URL=\"ws://localhost:9955\" deno run -A --unstable-detect-cjs --node-modules-dir ../../../packages/binaries/midnight-indexer/index.js --binary",
        "midnight-indexer:wait": "wait-on tcp:8088",
        // "midnight-proof-server:start": "docker run --name midnight-proof-server -e LEDGER_NETWORK_ID=Undeployed -e RUST_BACKTRACE=full -e SUBSTRATE_NODE_WS_URL=ws://localhost:9955 -p 6300:6300 midnightnetwork/proof-server",
        "midnight-proof-server:start": "deno run -A --unstable-detect-cjs --node-modules-dir ../../../packages/binaries/midnight-proof-server/index.js",
        "midnight-proof-server:wait": "wait-on tcp:6300",
        "midnight-contract:clean": "rm -rf midnight-level-db && rm -rf contract.json",
        "midnight-contract:deploy": "deno task midnight-contract:clean && deno --unstable-detect-cjs -A deploy.ts"
    },
    "imports": {
        "@midnight-ntwrk/ledger": "npm:@midnight-ntwrk/ledger",
        "@midnight-ntwrk/compact-runtime": "npm:@midnight-ntwrk/compact-runtime",
        "@midnight-ntwrk/zswap": "npm:@midnight-ntwrk/zswap",
        "@midnight-ntwrk/midnight-js-contracts": "npm:@midnight-ntwrk/midnight-js-contracts",
        "@midnight-ntwrk/midnight-js-http-client-proof-provider": "npm:@midnight-ntwrk/midnight-js-http-client-proof-provider",
        "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "npm:@midnight-ntwrk/midnight-js-indexer-public-data-provider",
        "@midnight-ntwrk/midnight-js-node-zk-config-provider": "npm:@midnight-ntwrk/midnight-js-node-zk-config-provider",
        "@midnight-ntwrk/midnight-js-types": "npm:@midnight-ntwrk/midnight-js-types",
        "@midnight-ntwrk/wallet": "npm:@midnight-ntwrk/wallet",
        "@midnight-ntwrk/wallet-api": "npm:@midnight-ntwrk/wallet-api",
        "@midnight-ntwrk/midnight-js-level-private-state-provider": "npm:@midnight-ntwrk/midnight-js-level-private-state-provider",
        "@midnight-ntwrk/midnight-js-utils": "npm:@midnight-ntwrk/midnight-js-utils",
        "@midnight-ntwrk/midnight-js-network-id": "npm:@midnight-ntwrk/midnight-js-network-id",
        "rxjs": "npm:rxjs",
        "ws": "npm:ws",
        "@std/path": "jsr:@std/path",
        "@std/fs": "jsr:@std/fs"
    }
}