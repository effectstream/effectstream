{
    "name": "@example/midnight-contracts-example-1",
    "version": "0.0.1",
    "exports": {
        ".": "./read-contract.ts"
    },
    "tasks": {
        "contract:clean": "rm -rf midnight-level-db && rm -rf contract.json",
        "contract:compile": "deno --unstable-detect-cjs -A compile.ts",
        "contract:deploy": "deno task contract:clean && deno --unstable-detect-cjs -A deploy.ts"
    }
}