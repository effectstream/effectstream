{
  "workspace": [
    "./packages/**/*"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "build:midnight": "deno task -r compact",
    "build:bitcoin": "echo 'done'",
    "dev": "deno task -f @night-bitcoin/node dev",
    "start:frontend": "deno task -f @night-bitcoin/frontend dev",
    "check": "deno task -f @night-bitcoin/node check"
  },
  "imports": {
    "@paimaexample/tui": "jsr:@paimaexample/tui@0.3.130",
    "@paimaexample/midnight-contracts": "jsr:@paimaexample/midnight-contracts@0.3.130",
    "@std/path": "jsr:@std/path@^1.1.3",
    "@std/log": "jsr:@std/log@^0.224.0"
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-this-alias",
        "require-yield",
        "no-explicit-any",
        "ban-types",
        "no-unused-vars",
        "no-slow-types"
      ]
    }
  }
}