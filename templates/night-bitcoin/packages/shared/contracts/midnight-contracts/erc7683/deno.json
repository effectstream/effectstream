{
  "name": "@night-bitcoin/midnight-contract-erc7683",
  "exports": {
    ".": "./src/_index.ts",
    "./witnesses": "./src/witnesses.ts",
    "./contract": "./src/managed/erc7683/contract/index.cjs"
  },
  "tasks": {
    "compact": "compact compile src/erc7683.compact src/managed/erc7683 && deno task convert:js",
    "convert:js": "deno run -A convert-js.ts src/managed/erc7683/contract/index.cjs src/managed/erc7683/contract/index.ts",
    "contract:compile": "deno task compact"
  },
  "imports": {
    "vitest": "npm:vitest@^3.2.4"
  }
}