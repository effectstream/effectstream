{
  "name": "@night-bitcoin/midnight-contracts",
  "version": "0.3.0",
  "exports": {
    "./transfer-funds": "./transfer-funds.ts"
  },
  "scripts": {
    "midnight-node:start": "CFG_PRESET=dev bunx @paimaexample/npm-midnight-node --dev --rpc-port 9944 --state-pruning archive --blocks-pruning archive --public-addr /ip4/127.0.0.1 --unsafe-rpc-external",
    "midnight-node:wait": "wait-on tcp:9944",
    "midnight-indexer:start": "CONFIG_FILE=`pwd`/indexer-standalone/config.yaml LEDGER_NETWORK_ID=\"Undeployed\" SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" APP__INFRA__SECRET=$(openssl rand -hex 32 | tr 'a-f' 'A-F') FEATURES_WALLET_ENABLED=\"true\" APP__INFRA__NODE__URL=\"ws://localhost:9944\" bunx @paimaexample/npm-midnight-indexer --binary --clean",
    "midnight-indexer:wait": "wait-on tcp:8088",
    "midnight-proof-server:start": "LEDGER_NETWORK_ID=\"Undeployed\" RUST_BACKTRACE=full SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" bunx @paimaexample/npm-midnight-proof-server",
    "midnight-proof-server:wait": "wait-on tcp:6300",
    "midnight-contract:clean": "rm -rf midnight-level-db && rm -rf contract.json",
    "midnight-contract:deploy": "bun run midnight-contract:clean && bun run deploy.ts",
    "midnight-faucet:start": "bun run faucet.ts",
    "create-wallets": "bun run create-wallets.ts ONLY_CREATE",
    "mint-wallets": "bun run create-wallets.ts ONLY_MINT"
  },
  "dependencies": {
    "@paimaexample/npm-midnight-indexer": "0.5.0",
    "@paimaexample/npm-midnight-node": "0.5.0",
    "@paimaexample/npm-midnight-proof-server": "0.5.0",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.0.0-beta.9",
    "@midnight-ntwrk/midnight-js-network-id": "3.0.0-alpha.11",
    "@midnight-ntwrk/midnight-js-types": "3.0.0-alpha.11",
    "@midnight-ntwrk/midnight-js-utils": "3.0.0-alpha.11",
    "@midnight-ntwrk/midnight-js-contracts": "3.0.0-alpha.11",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "3.0.0-alpha.11",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "3.0.0-alpha.11",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "3.0.0-alpha.11",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "3.0.0-alpha.11",
    "@midnight-ntwrk/wallet-api": "5.0.0",
    "@midnight-ntwrk/wallet": "5.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "3.0.0-beta.7",
    "@midnight-ntwrk/wallet-sdk-facade": "1.0.0-beta.12",
    "@midnight-ntwrk/wallet-sdk-shielded": "1.0.0-beta.11",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "1.0.0-beta.11",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "1.0.0-beta.14",
    "@midnight-ntwrk/wallet-sdk-abstractions": "1.0.0-beta.9",
    "@midnight-ntwrk/ledger-v6": "6.1.0-alpha.6",
    "@midnight-ntwrk/zswap": "4.0.0",
    "rxjs": "^7.8.2"
  }
}
