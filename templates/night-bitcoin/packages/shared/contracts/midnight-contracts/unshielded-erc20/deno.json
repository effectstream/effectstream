{
  "name": "@night-bitcoin/midnight-contract-unshielded-erc20",
  "exports": {
    ".": "./src/_index.ts",
    "./witnesses": "./src/witnesses.ts",
    "./contract": "./src/managed/contract/index.js"
  },
  "tasks": {
    "compact": "compact compile +0.27.0 src/unshielded-erc20.compact src/managed",
    "clean": "rm -rf src/managed",
    "convert:js": "deno run -A convert-js.ts src/managed/contract/index.js src/managed/contract/index.ts",
    "contract:compile": "deno task compact"
  },
  "imports": {
    "@midnight-ntwrk/compact-runtime": "npm:@midnight-ntwrk/compact-runtime@0.11.0-rc.1",
    "vitest": "npm:vitest@^3.2.4"
  }
}