{
    "name": "@night-bitcoin/midnight-contracts",
    "version": "0.3.0",
    "exports": {
        "./transfer-funds": "./transfer-funds.ts"
    },
    "tasks": {
        "midnight-node:start": "CFG_PRESET=dev deno run -A --unstable-detect-cjs npm:@paimaexample/npm-midnight-node --dev --rpc-port 9944 --state-pruning archive --blocks-pruning archive --public-addr /ip4/127.0.0.1 --unsafe-rpc-external",
        "midnight-node:wait": "wait-on tcp:9944",
        "midnight-indexer:start": "CONFIG_FILE=`pwd`/indexer-standalone/config.yaml LEDGER_NETWORK_ID=\"Undeployed\" SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" APP__INFRA__SECRET=$(openssl rand -hex 32 | tr 'a-f' 'A-F') FEATURES_WALLET_ENABLED=\"true\" APP__INFRA__NODE__URL=\"ws://localhost:9944\" deno run -A --unstable-detect-cjs npm:@paimaexample/npm-midnight-indexer --binary --clean",
        "midnight-indexer:wait": "wait-on tcp:8088",
        "midnight-proof-server:start": "LEDGER_NETWORK_ID=\"Undeployed\" RUST_BACKTRACE=full SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" deno run -A --unstable-detect-cjs npm:@paimaexample/npm-midnight-proof-server",
        "midnight-proof-server:wait": "wait-on tcp:6300",
        "midnight-contract:clean": "rm -rf midnight-level-db && rm -rf contract.json",
        "midnight-contract:deploy": "deno task midnight-contract:clean && deno --unstable-detect-cjs -A deploy.ts",
        "midnight-faucet:start": "deno run -A faucet.ts",
        "create-wallets": "deno run -A create-wallets.ts ONLY_CREATE",
        "mint-wallets": "deno run -A create-wallets.ts ONLY_MINT"
    },
    "imports": {
        // "@midnight-ntwrk/midnight-js-http-client-proof-provider": "npm:@midnight-ntwrk/midnight-js-http-client-proof-provider@^3.0.0-alpha.3",
        // "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "npm:@midnight-ntwrk/midnight-js-indexer-public-data-provider@^3.0.0-alpha.3",
        // "@midnight-ntwrk/midnight-js-level-private-state-provider": "npm:@midnight-ntwrk/midnight-js-level-private-state-provider@^3.0.0-alpha.3",
        // "@midnight-ntwrk/midnight-js-network-id": "npm:@midnight-ntwrk/midnight-js-network-id@^3.0.0-alpha.3",
        // "@midnight-ntwrk/midnight-js-node-zk-config-provider": "npm:@midnight-ntwrk/midnight-js-node-zk-config-provider@^3.0.0-alpha.3",
        // "@midnight-ntwrk/midnight-js-types": "npm:@midnight-ntwrk/midnight-js-types@^3.0.0-alpha.3",
        // "@midnight-ntwrk/midnight-js-utils": "npm:@midnight-ntwrk/midnight-js-utils@^3.0.0-alpha.3",
        "@midnight-ntwrk/wallet": "npm:@midnight-ntwrk/wallet@^5.0.0",
        "@midnight-ntwrk/wallet-api": "npm:@midnight-ntwrk/wallet-api@^5.0.0",
        "@midnight-ntwrk/wallet-sdk-address-format": "npm:@midnight-ntwrk/wallet-sdk-address-format@^2.0.0",
        "@midnight-ntwrk/wallet-sdk-hd": "npm:@midnight-ntwrk/wallet-sdk-hd@^2.0.0",
        "@paimaexample/npm-midnight-indexer": "npm:@paimaexample/npm-midnight-indexer@0.3.115",
        "@paimaexample/npm-midnight-node": "npm:@paimaexample/npm-midnight-node@0.3.115",
        "@paimaexample/npm-midnight-proof-server": "npm:@paimaexample/npm-midnight-proof-server@0.3.115",
        "@midnight-ntwrk/ledger": "npm:@midnight-ntwrk/ledger",
        "@midnight-ntwrk/compact-runtime": "npm:@midnight-ntwrk/compact-runtime@0.9.0",
        "@midnight-ntwrk/zswap": "npm:@midnight-ntwrk/zswap@^4.0.0",
        "@std/fs": "jsr:@std/fs@^1.0.19",
        "@std/path": "jsr:@std/path@^1.1.2",
        "rxjs": "npm:rxjs@^7.8.2"
    }
}