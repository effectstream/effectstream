{
  "name": "@night-bitcoin/database",
  "version": "0.3.0",
  "exports": "./src/mod.ts",
  "scripts": {
    "_pgtyped:my-sql": "bunx wait-on tcp:5432 && bunx @paimaexample/db/apply-migrations && bun run sql-to-ts.ts && bunx @pgtyped/cli -c ./pgtypedconfig.json",
    "pgtyped:update": "bunx concurrently --raw --kill-others \"bunx @paimaexample/db/db-up\" \"bun run _pgtyped:my-sql\""
  },
  "dependencies": {
    "@paimaexample/config": "0.5.0",
    "@paimaexample/runtime": "0.5.0",
    "@paimaexample/sm": "0.5.0",
    "@paimaexample/db": "0.5.0",
    "@pgtyped/runtime": "2.4.2",
    "pg": "^8.14.0",
    "effection": "3.5.0"
  },
  "devDependencies": {
    "@paima/pgtyped-cli": "^2.4.5",
    "concurrently": "9.1.2"
  }
}
