{
    "name": "@minimal/evm-contracts",
    "exports": {
        ".": "./mod.ts",
        "./build": "./build/mod.ts",
        "./contractAddressesEvmMain": "./build/contractAddressesEvmMain.ts"
    },
    "version": "0.3.23",
    "license": "MIT",
    // TODO: how these actually will work will depend on the hardhat v3 viem plugin
    //       See https://github.com/NomicFoundation/hardhat/issues/5978
    "imports": {
        "@paimaexample/evm-hardhat": "jsr:@paimaexample/evm-hardhat@0.3.43",
        "@paimaexample/log": "jsr:@paimaexample/log@0.3.43",
        "@wagmi/cli": "npm:@wagmi/cli@2.3.1",
        "hardhat": "npm:hardhat@3.0.4",
        "@nomicfoundation/hardhat-ignition-viem": "npm:@nomicfoundation/hardhat-ignition-viem@3.0.2",
        "@nomicfoundation/hardhat-ignition": "npm:@nomicfoundation/hardhat-ignition-viem@3.0.2",
        "@nomicfoundation/hardhat-viem": "npm:@nomicfoundation/hardhat-viem@3.0.0",
        "@nomicfoundation/ignition-core": "npm:@nomicfoundation/ignition-core@3.0.2",
        // required for https://github.com/NomicFoundation/hardhat/issues/6472
        "ws": "npm:ws@8.18.1",
        "@nomicfoundation/hardhat-errors": "npm:@nomicfoundation/hardhat-errors@3.0.1", // required for https://github.com/NomicFoundation/hardhat/issues/6472
        "@nomicfoundation/hardhat-utils": "npm:@nomicfoundation/hardhat-utils@3.0.0" // required for https://github.com/NomicFoundation/hardhat/issues/6472
    },
    "tasks": {
        "swap:remappings:forge": "deno -A @paimaexample/evm-hardhat/remappings-forge --depth 2 --package @paimaexample",
        "swap:remappings:hardhat": "deno -A @paimaexample/evm-hardhat/remappings-hardhat --package @paimaexample",
        "check": "./mod.ts",
        "build:mod": "deno run -A @paimaexample/evm-hardhat/builder",
        "build:clean": "rm -rf build || true",
        "build:forge": "deno task swap:remappings:forge && forge build",
        "build:hardhat": "deno task swap:remappings:hardhat && deno run -A npm:hardhat@3.0.4 compile && deno task build:mod",
        "build": "deno task build:clean && deno task build:forge && deno task build:hardhat && deno task build:mod",
        "deploy:clean": "rm -rf ignition/deployments || true",
        "deploy:standalone": "deno task deploy:clean && ((deno task chain:start) &) && (deno task chain:wait) && (deno task deploy) && kill -9 $(lsof -ti tcp:8545)",
        "deploy": "deno task deploy:clean && deno run -A deploy.ts",
        "chain:start": "deno run -A npm:hardhat@3.0.4 node",
        "chain:wait": "deno run -A npm:hardhat@3.0.4 node wait"
    }
}