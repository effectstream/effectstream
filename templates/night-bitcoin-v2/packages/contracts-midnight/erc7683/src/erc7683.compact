// ERC-7683 Cross-Chain Intents Contract for Midnight
pragma language_version >= 0.17.0;

import CompactStandardLibrary;
import "base-contracts/src/access/Ownable" prefix Ownable_;

// THIS IS A EXAMPLE CONTRACT FOR DEMONSTRATION PURPOSES ONLY
// DO NOT USE THIS CONTRACT IN PRODUCTION

export ledger lastIntentType: Uint<8>;
export ledger lastIntentEvent: Intent;
export ledger lastFillerEvent: Bytes<128>;
export ledger lastIntentOrderId: Bytes<32>;

export ledger intents: Map<Bytes<32>, Intent>;
export ledger fillers: Map<Bytes<32>, Bytes<128>>;

// Represents a cross-chain intent, based on a simplified ERC-7683 `ResolvedCrossChainOrder`.
struct Intent {
  user: Bytes<256>;
  originChainId: Uint<128>;
  openDeadline: Uint<32>;
  fillDeadline: Uint<32>;
  
  // Simplified `maxSpent` (assuming one output)
  maxSpent_token: Bytes<32>;
  maxSpent_amount: Uint<128>;
  maxSpent_recipient: Bytes<256>;
  maxSpent_chainId: Uint<128>;

  // Simplified `minReceived` (assuming one output)
  minReceived_token: Bytes<32>;
  minReceived_amount: Uint<128>;
  minReceived_recipient: Bytes<256>;
  minReceived_chainId: Uint<128>;

  // Simplified `fillInstructions` (assuming one instruction)
  destinationChainId: Uint<64>;
  destinationSettler: Bytes<32>;
  originData: Bytes<256>;

  // Status of the intent:
  // 0: Initialized
  // 1: Validated Initialized (funds locked)
  // 2: Resolved
  // 3: Validated Resolved (filler paid)
  status: Uint<8>;
}



constructor(
  /*initialOwner: Either<ZswapCoinPublicKey, ContractAddress>*/
  ) {
  // Ownable_initialize(initialOwner);
}

/**
 * @description Creates a new cross-chain intent.
 * @param orderId A unique identifier for the intent.
 */
export circuit initialize(
  user: Bytes<256>,
  orderId: Bytes<32>,
  originChainId: Uint<128>,
  openDeadline: Uint<32>,
  fillDeadline: Uint<32>,
  maxSpent_token: Bytes<32>,
  maxSpent_amount: Uint<128>,
  maxSpent_recipient: Bytes<256>,
  maxSpent_chainId: Uint<128>,
  minReceived_token: Bytes<32>,
  minReceived_amount: Uint<128>,
  minReceived_recipient: Bytes<256>,
  minReceived_chainId: Uint<128>,
  destinationChainId: Uint<64>,
  destinationSettler: Bytes<32>,
  originData: Bytes<256>
): [] {
  assert(!intents.member(disclose(orderId)), "Intent with this orderId already exists");

 const newIntent = Intent {
    user: disclose(user),
    originChainId: originChainId,
    openDeadline: openDeadline,
    fillDeadline: fillDeadline,
    maxSpent_token: maxSpent_token,
    maxSpent_amount: maxSpent_amount,
    maxSpent_recipient: maxSpent_recipient,
    maxSpent_chainId: maxSpent_chainId,
    minReceived_token: minReceived_token,
    minReceived_amount: minReceived_amount,
    minReceived_recipient: minReceived_recipient,
    minReceived_chainId: minReceived_chainId,
    destinationChainId: destinationChainId,
    destinationSettler: destinationSettler,
    originData: originData,
    status: 0,
  };
  lastIntentOrderId = disclose(orderId);
  lastIntentType = 0;
  lastIntentEvent = disclose(newIntent);
  intents.insert(disclose(orderId), disclose(newIntent));
}

/**
 * @description Validates the initialization of an intent, marking funds as locked.
 * @dev This function should only be callable by the contract owner.
 * @param orderId The identifier of the intent to validate.
 */
export circuit validate_initialize(user: Bytes<256>, orderId: Bytes<32>): [] {
  // Ownable_assertOnlyOwner();
  assert(intents.member(disclose(orderId)), "Intent with this orderId does not exist");
  const intent = intents.lookup(disclose(orderId));
  assert(intent.status == 0, "Intent not in initialized state");

  const updatedIntent = Intent {
    user: disclose(user),
    originChainId: intent.originChainId,
    openDeadline: intent.openDeadline,
    fillDeadline: intent.fillDeadline,
    maxSpent_token: intent.maxSpent_token,
    maxSpent_amount: intent.maxSpent_amount,
    maxSpent_recipient: intent.maxSpent_recipient,
    maxSpent_chainId: intent.maxSpent_chainId,
    minReceived_token: intent.minReceived_token,
    minReceived_amount: intent.minReceived_amount,
    minReceived_recipient: intent.minReceived_recipient,
    minReceived_chainId: intent.minReceived_chainId,
    destinationChainId: intent.destinationChainId,
    destinationSettler: intent.destinationSettler,
    originData: intent.originData,
    status: 1, // validated_initialized
  };
  lastIntentOrderId = disclose(orderId);
  lastIntentType = 1;
  lastIntentEvent = disclose(updatedIntent);
  intents.insert(disclose(orderId), disclose(updatedIntent));
}

/**
 * @description Marks an intent as resolved by a filler.
 * @param orderId The identifier of the intent to resolve.
 */
export circuit resolve(filler: Bytes<128>, orderId: Bytes<32>): [] {

  assert(intents.member(disclose(orderId)), "Intent with this orderId does not exist");
  const intent = intents.lookup(disclose(orderId));
  assert(intent.status == 1, "Intent not in validated_initialized state");

  // TODO: Add deadline checks once block timestamp functionality is available.

  const updatedIntent = Intent {
    user: intent.user,
    originChainId: intent.originChainId,
    openDeadline: intent.openDeadline,
    fillDeadline: intent.fillDeadline,
    maxSpent_token: intent.maxSpent_token,
    maxSpent_amount: intent.maxSpent_amount,
    maxSpent_recipient: intent.maxSpent_recipient,
    maxSpent_chainId: intent.maxSpent_chainId,
    minReceived_token: intent.minReceived_token,
    minReceived_amount: intent.minReceived_amount,
    minReceived_recipient: intent.minReceived_recipient,
    minReceived_chainId: intent.minReceived_chainId,
    destinationChainId: intent.destinationChainId,
    destinationSettler: intent.destinationSettler,
    originData: intent.originData,
    status: 2, // resolved
  };
  lastIntentOrderId = disclose(orderId);
  lastIntentType = 2;
  lastIntentEvent = disclose(updatedIntent);
  lastFillerEvent = disclose(filler);

  intents.insert(disclose(orderId), disclose(updatedIntent));
  fillers.insert(disclose(orderId), disclose(filler));
}

/**
 * @description Validates the resolution of an intent, marking the filler as paid.
 * @dev This function should only be callable by the contract owner.
 * @param orderId The identifier of the intent to validate.
 */
export circuit validate_resolve(filler: Bytes<128>, orderId: Bytes<32>): [] {
  // Ownable_assertOnlyOwner();
  assert(intents.member(disclose(orderId)), "Intent with this orderId does not exist");
  const intent = intents.lookup(disclose(orderId));
  assert(intent.status == 2, "Intent not in resolved state");
  
  assert(fillers.member(disclose(orderId)), "Filler not found for this intent");
  assert(fillers.lookup(disclose(orderId)) == disclose(filler), "Filler mismatch");

  // TODO: Implement logic to pay the filler. This would involve transferring
  // `intent.minReceived_amount` of `intent.minReceived_token` to the filler.

  const updatedIntent = Intent {
    user: intent.user,
    originChainId: intent.originChainId,
    openDeadline: intent.openDeadline,
    fillDeadline: intent.fillDeadline,
    maxSpent_token: intent.maxSpent_token,
    maxSpent_amount: intent.maxSpent_amount,
    maxSpent_recipient: intent.maxSpent_recipient,
    maxSpent_chainId: intent.maxSpent_chainId,
    minReceived_token: intent.minReceived_token,
    minReceived_amount: intent.minReceived_amount,
    minReceived_recipient: intent.minReceived_recipient,
    minReceived_chainId: intent.minReceived_chainId,
    destinationChainId: intent.destinationChainId,
    destinationSettler: intent.destinationSettler,
    originData: intent.originData,
    status: 3, // validated_resolved
  };
  lastIntentOrderId = disclose(orderId);
  lastIntentType = 3;
  lastIntentEvent = disclose(updatedIntent);
  lastFillerEvent = disclose(filler);
  intents.insert(disclose(orderId), disclose(updatedIntent));
}

/**
 * @description Retrieves the current status of an intent.
 * @param orderId The identifier of the intent to query.
 * @return The status code of the intent.
 */
export circuit getIntentStatus(user: Bytes<256>, orderId: Bytes<32>): Uint<8> {
    assert(intents.member(disclose(orderId)), "Intent with this orderId does not exist");
    const intent = intents.lookup(disclose(orderId));
    assert(intent.user == disclose(user), "User mismatch");
    return intent.status;
}