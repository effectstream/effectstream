// SPDX-License-Identifier: MIT
//
// Minting authority for the night-bitcoin "M20" token, implemented via
// Midnight's native unshielded coin system (mintUnshieldedToken). Replaces
// the previous FungibleToken-based ERC-20 — there is no contract-side
// balance ledger; balances live in the recipient's wallet as native
// unshielded coins, colored by (contract address, domain_sep).
//
// Action ledger fields (actionName / actionInitiator / actionTarget / actionValue)
// are kept so the existing state-machine consumers can continue to observe
// mint events via the midnight-generic primitive.
pragma language_version >= 0.17.0;

import CompactStandardLibrary;

export ledger counter: Uint<128>;

// Action event ledger fields — written on every mint_unshielded call.
// actionName 1001 = mint.
export ledger actionName: Uint<128>;
export ledger actionInitiator: Either<ZswapCoinPublicKey, ContractAddress>;
export ledger actionTarget: Either<ZswapCoinPublicKey, ContractAddress>;
export ledger actionValue: Uint<128>;
export ledger lastDomainSep: Bytes<32>;
export ledger lastTokenColor: Bytes<32>;

export circuit mint_unshielded(
  domainSep: Bytes<32>,
  amount: Uint<64>,
  recipient: UserAddress,
): Bytes<32> {
  const color = mintUnshieldedToken(
    disclose(domainSep),
    disclose(amount),
    right<ContractAddress, UserAddress>(disclose(recipient)),
  );

  counter = counter + 1 as Uint<128>;

  const caller = ownPublicKey();
  actionName = 1001;
  actionInitiator = left<ZswapCoinPublicKey, ContractAddress>(caller);
  // Recipient is a UserAddress (not a ZswapCoinPublicKey); we encode it on the
  // left side so downstream STM code that reads actionTarget.left.bytes keeps
  // working. The bytes are the recipient's user-address public key.
  actionTarget = left<ZswapCoinPublicKey, ContractAddress>(
    ZswapCoinPublicKey { bytes: disclose(recipient).bytes },
  );
  actionValue = disclose(amount) as Uint<128>;
  lastDomainSep = disclose(domainSep);
  lastTokenColor = color;

  return color;
}
