/**
 * @title MyToken
 * @description A contract that acts as a Minting Authority for a specific asset
 *              within the Zswap protocol.
 */
// -------------------------------------------------------------------------
  // Ledger State
  // -------------------------------------------------------------------------
  
  // The Public Key allowed to mint new tokens
  export ledger admin: ZswapCoinPublicKey;

  // The unique identifier (color) for this token
  export ledger tokenColor: Bytes<32>;

  // -------------------------------------------------------------------------
  // Constructor
  // -------------------------------------------------------------------------

/**
  * @circuit constructor
  * @param owner The public key that can mint tokens.
  * @param color The 32-byte identifier for this token (pad this in JS).
  */
constructor(/* owner: ZswapCoinPublicKey, */color: Bytes<32>) {
    // admin = disclose(owner);
    // Fix: Assign directly. 'pad' only works with literal strings like "USD"
    tokenColor = disclose(color); 
}

