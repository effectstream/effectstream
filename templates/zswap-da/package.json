{
  "name": "@zswap-da/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 10600 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 10600 --host",
    "serve": "vite preview --port 10600 --host"
  },
  "dependencies": {
    "@effectstream/midnight-contracts": "0.200.1",
    "@effectstream/mip-zswap-offer": "0.4.0-v9.0",
    "@effectstream/wallets": "0.200.1",
    "@midnight-ntwrk/dapp-connector-api": "4.1.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^2.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-node-stdlib-browser": "0.2.1",
    "node-stdlib-browser": "^1.2.0",
    "crypto-browserify": "^3.12.1",
    "vite-plugin-wasm": "^3.4.1"
  },
  "//overrides": [
    "ledger-v9 and onchain-runtime-v4 are wasm-bindgen modules: their exported",
    "classes carry per-instance type identity, so two copies in one bundle make",
    "every cross-copy value fail an instanceof check (e.g. 'expected instance of",
    "LedgerParameters'). midnight-js 5.0.0 pins ledger-v9 1.0.0 / onchain-runtime-v4",
    "4.0.0 exactly while the wallet SDK, compact-js and mip-zswap-offer accept other",
    "versions, so these overrides collapse every consumer onto one copy (which also",
    "keeps ~10 MB of duplicate wasm out of the bundle)."
  ],
  "overrides": {
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0",
    "@midnight-ntwrk/onchain-runtime": "npm:@midnightntwrk/onchain-runtime-v4@4.0.0"
  }
}
