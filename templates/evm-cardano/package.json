    "build:pgtypes": "bun run --filter @evm-cardano/database pgtyped:update"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@effectstream/evm-contracts": "0.104.0",
    "@effectstream/orchestrator": "0.104.0",
    "@midnightntwrk/wallet-sdk-address-format": "3.1.2",
    "wait-on": "8.0.3"
  },
  "effectstream": {
    "default": "start.dev.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  }
}
