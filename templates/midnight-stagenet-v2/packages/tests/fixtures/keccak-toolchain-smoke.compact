pragma language_version >= 0.25.0;

import CompactStandardLibrary;

export ledger lastDigest: Bytes<32>;

constructor() {
  lastDigest = default<Bytes<32>>;
}

export circuit hashAndStore(value: Bytes<32>): Bytes<32> {
  const digest: Bytes<32> = keccak256<Bytes<32>>(value);
  lastDigest = disclose(digest);
  return disclose(digest);
}
