**

!package.json
!bun.lock
!templates
templates/*
!templates/run-template-tests.ts
!templates/midnight-stagenet-v2
!templates/midnight-stagenet-v2/**

# C20 admits only the CI classifier and workflow files needed to prove that the
# Docker-managed template cannot fall through to the ordinary in-image runner.
!.github
.github/*
!.github/ci-changes.ts
!.github/workflows
.github/workflows/*
!.github/workflows/main.yaml
!.github/workflows/midnight-stagenet-v2-live.yaml

# C07+ hash the legacy v1 config to prove the isolated v2 profile does not
# change it. C08 additionally admits only the isolated v2 provider package.
!packages
packages/*
!packages/chains
packages/chains/*
!packages/chains/midnight-contracts
!packages/chains/midnight-contracts/**
!packages/chains/midnight-contracts-v2
!packages/chains/midnight-contracts-v2/**

!e2e/**/
e2e/**/*
!e2e/**/package.json

# C13 admits only the API-v4 client seam and its hermetic decoder test.
!packages/node-sdk
packages/node-sdk/*
!packages/node-sdk/sync
packages/node-sdk/sync/*
!packages/node-sdk/sync/src
packages/node-sdk/sync/src/*
!packages/node-sdk/sync/src/sync-protocols
packages/node-sdk/sync/src/sync-protocols/*
!packages/node-sdk/sync/src/sync-protocols/midnight
packages/node-sdk/sync/src/sync-protocols/midnight/*
!packages/node-sdk/sync/src/sync-protocols/midnight/MidnightClient.ts
!packages/node-sdk/sync/src/sync-protocols/midnight/types.ts
!packages/node-sdk/sync/test
packages/node-sdk/sync/test/*
!packages/node-sdk/sync/test/midnight-event-decoder.test.ts

# C14 installs the root workspace in-container. Admit every workspace manifest
# plus only the source packages needed by the Midnight sync/primitive suites.
!packages/**/
packages/**/*
!packages/**/package.json
!packages/effectstream-sdk/concise/**
!packages/effectstream-sdk/config/**
!packages/effectstream-sdk/coroutine/**
!packages/effectstream-sdk/crypto/**
!packages/effectstream-sdk/events/**
!packages/effectstream-sdk/log/**
!packages/effectstream-sdk/utils/**
!packages/node-sdk/db/**
!packages/node-sdk/sm/**
!packages/node-sdk/sync/**
!packages/chains/midnight-contracts/**
!packages/chains/midnight-contracts-v2/**

# Never admit host dependency trees even when a selected package has one.
**/node_modules
**/node_modules/**

# This committed sentinel proves this Dockerfile-specific allowlist is active.
templates/midnight-stagenet-v2/.context-excluded.sentinel

# Compose mounts this public undeployed-genesis test seed as a runtime secret.
# Keep even test credentials out of every Docker build context and image layer.
templates/midnight-stagenet-v2/packages/tests/fixtures/undeployed-genesis-seed.txt
