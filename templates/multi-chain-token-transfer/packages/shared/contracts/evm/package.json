{
  "name": "@multi-chain-transfer/evm-contracts",
  "version": "0.3.22",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./mod.ts",
    "./build": "./build/mod.ts",
    "./contractAddressesEvmMain": "./build/contractAddressesEvmMain.ts"
  },
  "scripts": {
    "swap:remappings:forge": "bunx @paimaexample/evm-hardhat/remappings-forge --depth 4 --package @paimaexample",
    "swap:remappings:hardhat": "bunx @paimaexample/evm-hardhat/remappings-hardhat",
    "check": "echo 'check'",
    "build:mod": "(bun run deploy:standalone || true) && bun run @paimaexample/evm-hardhat/builder",
    "build:clean": "rm -rf build || true",
    "build:forge": "bun run swap:remappings:forge && forge build",
    "build:hardhat": "bun run swap:remappings:hardhat && bunx hardhat@3.0.4 compile",
    "build": "bun run build:clean && bun run build:forge && bun run build:hardhat",
    "deploy:clean": "rm -rf ignition/deployments || true",
    "contract:compile": "bun run build:mod",
    "deploy:standalone": "bun run deploy:clean && bun run build && (((bun run chain:start) &) && (bun run chain:wait) && (bun run deploy) && (bun run chain:stop)) || true",
    "deploy": "bun run deploy:clean && bun run deploy.ts",
    "chain:start": "bunx hardhat@3.0.4 node",
    "chain:stop": "kill -9 $(lsof -ti tcp:8545) || true",
    "chain:wait": "bunx hardhat@3.0.4 node wait"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.1.0",
    "@paimaexample/evm-contracts": "0.3.116",
    "@paimaexample/evm-hardhat": "0.3.116",
    "@paimaexample/log": "0.3.116",
    "@wagmi/cli": "2.3.1",
    "hardhat": "3.0.4",
    "@nomicfoundation/hardhat-ignition-viem": "3.0.2",
    "@nomicfoundation/hardhat-viem": "3.0.0",
    "@nomicfoundation/ignition-core": "3.0.2",
    "ws": "8.18.1",
    "@nomicfoundation/hardhat-errors": "3.0.1",
    "@nomicfoundation/hardhat-utils": "3.0.0"
  },
  "devDependencies": {
    "jsonc-parser": "3.3.1",
    "@opentelemetry/sdk-node": "0.56.0",
    "wait-on": "8.0.3"
  }
}
