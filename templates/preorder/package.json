{
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "NODE_ENV=development bunx orchestrator start",
    "test": "bun run packages/tests/run-tests.ts",
    "build:evm": "bun run --filter @preorder/contracts-evm build:mod",
    "build:pgtypes": "bun run --filter @preorder/database pgtyped:update",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/libsodium-wrappers-sumo/dist/modules-sumo-esm/libsodium-sumo.mjs';if(!fs.existsSync(p))fs.symlinkSync('../../../libsodium-sumo/dist/modules-sumo-esm/libsodium-sumo.mjs',p)\""
  },
  "dependencies": {
    "@effectstream/evm-contracts": "0.200.1",
    "@effectstream/orchestrator": "0.200.1",
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/http-proxy": "^11.4.4",
    "@midnightntwrk/wallet-sdk-address-format": "3.1.2",
    "buffer": "^6.0.3",
    "libsodium-sumo": "0.7.16",
    "libsodium-wrappers-sumo": "0.7.16",
    "viem": "^2.30.0",
    "wait-on": "8.0.3"
  },
  "effectstream": {
    "default": "start.dev.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.13",
    "vite-plugin-wasm": "^3.6.0"
  }
}
