VITE_IS_BUN=true
VITE_API_URL=https://your-api.example.com
VITE_BATCHER_URL=https://your-batcher.example.com
# Midnight mainnet indexer and node are hosted by Blockfrost. Replace <token>
# with a project ID from a free blockfrost.io account (one project per network;
# mainnet IDs start with "nightmainnet", preprod with "nightpreprod"). A token
# for another network is rejected with 403 "Network token mismatch".
# The indexer values are complete endpoint URLs (Blockfrost path /api/v0) and
# carry no token: the frontend appends ?project_id=<token> to the indexer,
# indexer WS and node URLs whenever VITE_MIDNIGHT_BLOCKFROST_PROJECT_ID is set.
# Every VITE_* value, the project ID included, is compiled into the public
# frontend bundle and cannot be hidden: use a Blockfrost project dedicated to
# the frontend and expect its ID to be visible to anyone who loads the page.
VITE_MIDNIGHT_INDEXER_HTTP=https://midnight-mainnet.blockfrost.io/api/v0
VITE_MIDNIGHT_INDEXER_WS=wss://midnight-mainnet.blockfrost.io/api/v0/ws
VITE_MIDNIGHT_NODE_HTTP=https://rpc.midnight-mainnet.blockfrost.io
VITE_MIDNIGHT_BLOCKFROST_PROJECT_ID=<token>
# The proof server always runs locally next to the user; there is no hosted one.
VITE_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
VITE_MIDNIGHT_NETWORK_ID=mainnet
