VITE_IS_BUN=true
VITE_API_URL=https://your-api.example.com
VITE_BATCHER_URL=https://your-batcher.example.com
# Midnight mainnet indexer and node are hosted by Blockfrost. Replace <token>
# with a project ID from a free blockfrost.io account (one project per network;
# mainnet IDs start with "nightmainnet", preprod with "nightpreprod"). A token
# for another network is rejected with 403 "Network token mismatch".
# These URLs embed a secret: keep them out of logs and version control, and
# note that VITE_* values are compiled into the public frontend bundle.
# The indexer values are complete GraphQL endpoints (Blockfrost path /api/v0).
VITE_MIDNIGHT_INDEXER_HTTP=https://midnight-mainnet.blockfrost.io/api/v0?project_id=<token>
VITE_MIDNIGHT_INDEXER_WS=wss://midnight-mainnet.blockfrost.io/api/v0/ws?project_id=<token>
VITE_MIDNIGHT_NODE_HTTP=https://rpc.midnight-mainnet.blockfrost.io?project_id=<token>
# The proof server always runs locally next to the user; there is no hosted one.
VITE_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
VITE_MIDNIGHT_NETWORK_ID=mainnet
