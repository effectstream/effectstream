{
  "workspace": [
    "./packages/client/*",
    "./packages/shared/**/*"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@paimaexample/evm-contracts": "jsr:@paimaexample/evm-contracts@0.3.108"
  },
  "tasks": {
    "build:evm": "deno task -f @world-map-2d/evm-contracts build:mod",
    "dev": "deno task -f @world-map-2d/node dev",
    "check": "deno task -f @world-map-2d/node check"
  },
  "lint": {
    "rules": {
      "exclude": [
        // needed for generators since you can't use the arrow function syntax
        "no-this-alias",
        // this is too strict to play well with effection
        "require-yield",
        // way too many typescript things that require using `any`
        "no-explicit-any",
        "ban-types", // `Function` and `{}` are occasionally useful
        "no-unused-vars", // maybe enable this at some point
        "no-slow-types" // would be nice to have, but this is a lot of work
      ]
    }
  }
}
