{
  "name": "@world-map-2d/db",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./src/mod.ts",
  "scripts": {
    "_pgtyped:my-sql": "bunx @paimaexample/db/db-wait && bunx @paimaexample/db/apply-migrations && bun run sql-to-ts.ts && pgtyped -c ./pgtypedconfig.json",
    "pgtyped:update": "concurrently --raw --kill-others \"bunx @paimaexample/db/db-up\" \"bun run _pgtyped:my-sql\""
  },
  "dependencies": {
    "@effectstream/config": "0.100.18",
    "@effectstream/runtime": "0.100.18",
    "@pgtyped/runtime": "2.4.2",
    "@effectstream/db": "0.100.18",
    "@effectstream/db-emulator": "0.100.18",
    "pg": "^8.14.0",
    "effection": "3.5.0"
  },
  "devDependencies": {
    "@paima/pgtyped-cli": "^2.4.5",
    "concurrently": "9.1.2"
  }
}
