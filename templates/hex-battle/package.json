{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:evm": "bun run --filter @hex-battle/contracts-evm build:mod",
    "dev": "NODE_ENV=development bunx orchestrator start",
    "check": "bun run --filter @hex-battle/node check",
    "test": "bun run packages/tests/run-tests.ts",
    "test:launch": "bun run packages/tests/frontend/launch.test.ts",
    "test:practice": "bun run packages/frontend/practice-ai.test.ts",
    "build:pgtypes": "bun run --filter @hex-battle/database pgtyped:update"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@effectstream/evm-contracts": "0.300.1",
    "@effectstream/orchestrator": "0.300.1",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0",
    "wait-on": "8.0.3"
  },
  "effectstream": {
    "default": "start.dev.ts"
  },
  "overrides": {
    "@midnightntwrk/ledger-v9": "1.0.0",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0",
    "@midnight-ntwrk/onchain-runtime": "npm:@midnightntwrk/onchain-runtime-v4@4.0.0"
  }
}
