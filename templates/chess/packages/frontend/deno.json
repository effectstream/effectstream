    "@thirdweb-dev/sdk": "npm:@thirdweb-dev/sdk@2.4.1",
    "clsx": "npm:clsx@^1.2.1",
    "eslint-plugin-react-hooks": "npm:eslint-plugin-react-hooks@^4.6.0",
    "react-chessboard": "npm:react-chessboard@^2.0.8",
    "@sinclair/typebox": "npm:@sinclair/typebox@^0.34.30"
  },
  "compilerOptions": {
    "strict": true,
    "types": [
      "react",
      "react-dom",
      "@types/react"
    ],
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}