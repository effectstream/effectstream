{
  "name": "@chess/node",
  "version": "0.3.23",
  "license": "MIT",
  "exports": {
    ".": "./src/main.ts",
  },
  "tasks": {
    // separate from node:start so we can type-check before starting other services
    "check": "deno check --unstable-raw-imports src/main.ts",
    // Open chrome://inspect to see the inspector
    "node:start": "deno run -A --inspect --unstable-raw-imports src/main.ts",
    "dev": "deno task -f @effectstream/tui clean && NODE_ENV=development deno run -A --check --unstable-raw-imports scripts/start.ts",
    "test": "deno run -A --unstable-raw-imports --check scripts/e2e.test.ts"
  },
  "imports": {
    "@midnight-ntwrk/compact-runtime": "npm:@midnight-ntwrk/compact-runtime@^0.9.0",
    "@midnight-ntwrk/ledger": "npm:@midnight-ntwrk/ledger@^4.0.0",
    "@midnight-ntwrk/midnight-js-contracts": "npm:@midnight-ntwrk/midnight-js-contracts@^2.0.2",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "npm:@midnight-ntwrk/midnight-js-fetch-zk-config-provider@^2.0.2",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "npm:@midnight-ntwrk/midnight-js-http-client-proof-provider@^2.0.2",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "npm:@midnight-ntwrk/midnight-js-indexer-public-data-provider@^2.0.2",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "npm:@midnight-ntwrk/midnight-js-level-private-state-provider@^2.0.2",
    "@midnight-ntwrk/midnight-js-network-id": "npm:@midnight-ntwrk/midnight-js-network-id@^2.0.2",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "npm:@midnight-ntwrk/midnight-js-node-zk-config-provider@^2.0.2",
    "@midnight-ntwrk/midnight-js-types": "npm:@midnight-ntwrk/midnight-js-types@^2.0.2",
    "@midnight-ntwrk/midnight-js-utils": "npm:@midnight-ntwrk/midnight-js-utils@^2.0.2",
    "@midnight-ntwrk/onchain-runtime": "npm:@midnight-ntwrk/onchain-runtime@^0.3.0",
    "@midnight-ntwrk/wallet": "npm:@midnight-ntwrk/wallet@^5.0.0",
    "@midnight-ntwrk/wallet-api": "npm:@midnight-ntwrk/wallet-api@^5.0.0",
    "@midnight-ntwrk/zswap": "npm:@midnight-ntwrk/zswap@^4.0.0",
    "@effectstream/batcher": "jsr:@effectstream/batcher@0.3.99",
    "@effectstream/crypto": "jsr:@effectstream/crypto@0.3.99",
    "@effectstream/concise": "jsr:@effectstream/concise@0.3.99",
    "@effectstream/config": "jsr:@effectstream/config@0.3.99",
    "@effectstream/explorer": "jsr:@effectstream/explorer@0.3.99",
    "@effectstream/log": "jsr:@effectstream/log@0.3.99",
    "@effectstream/orchestrator": "jsr:@effectstream/orchestrator@0.3.99",
    "@effectstream/runtime": "jsr:@effectstream/runtime@0.3.99",
    "@effectstream/utils": "jsr:@effectstream/utils@0.3.99",
    "@effectstream/sm": "jsr:@effectstream/sm@0.3.99",
    "@effectstream/coroutine": "jsr:@effectstream/coroutine@0.3.99",
