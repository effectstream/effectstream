# Rust/SBF build artifacts
programs/bridge/target/

# Compiled program. build/bridge.so IS committed on purpose: the CI image has no
# Rust toolchain, an Apple-silicon Docker host cannot build it (QEMU rustc
# SIGSEGVs), and cargo-build-sbf lives in @effectstream/solana-node's vendor/
# dir, which is only populated when the validator downloads. Rebuild natively
# with `bun run build:program` after editing programs/bridge/src/lib.rs.
/build/*
!/build/bridge.so

# solana-test-validator scratch ledger
test-ledger/

# rustfmt backups
**/*.rs.bk

# Keypairs. keypair/bridge-program.json IS committed on purpose so the local
# program id stays deterministic: its secret is public, it is for the local
# validator only, and deploy-devnet.ts refuses it. Every OTHER keypair —
# including the generated local-operator.json / local-user.json — stays out.
# Live keys never live in the repo (~/.config/solana-midnight-bridge/ or $BRIDGE_SECRETS_DIR).
keypair/*.json
!keypair/bridge-program.json
