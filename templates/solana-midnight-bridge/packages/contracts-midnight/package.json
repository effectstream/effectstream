{
  "name": "@solana-midnight-bridge/contracts-midnight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./mod.ts",
    "./contract": "./contract.ts",
    "./signing": "./signing.ts",
    "./network": "./network.ts",
    "./wallets": "./wallets.ts",
    "./deploy": "./deploy.ts",
    "./client": "./client.ts"
  },
  "scripts": {
    "compile": "bash scripts/compile.sh",
    "compile:ts": "bash scripts/compile.sh --skip-zk",
    "fetch-compactc": "bash scripts/fetch-compactc.sh",
    "check:runtime-alias": "bun run scripts/check-runtime-alias.ts",
    "deploy:local": "bun run deploy.ts --mode local",
    "deploy:stagenet": "bun run deploy.ts --mode stagenet",
    "midnight-node:start": "MIDNIGHT_STORAGE_PASSWORD=YourPasswordMy1! CFG_PRESET=dev bun ./node_modules/.bin/npm-midnight-node --dev --rpc-port 9944 --port 30333 --state-pruning archive --blocks-pruning archive --public-addr /ip4/127.0.0.1 --unsafe-rpc-external",
    "midnight-node:wait": "bun ./node_modules/.bin/wait-on tcp:9944",
    "midnight-indexer:start": "RUST_BACKTRACE=1 LEDGER_NETWORK_ID=\"Undeployed\" SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" APP__INFRA__SECRET=$(openssl rand -hex 32 | tr 'a-f' 'A-F') FEATURES_WALLET_ENABLED=\"true\" APP__INFRA__NODE__URL=\"ws://localhost:9944\" bun ./node_modules/.bin/npm-midnight-indexer --binary --clean",
    "midnight-indexer:wait": "bun ./node_modules/.bin/wait-on tcp:8088",
    "midnight-proof-server:start": "RUST_BACKTRACE=full SUBSTRATE_NODE_WS_URL=\"ws://localhost:9944\" bun ./node_modules/.bin/npm-midnight-proof-server",
    "midnight-proof-server:wait": "bun ./node_modules/.bin/wait-on tcp:6300",
    "midnight-contract-prover:start": "MIDNIGHT_PROOF_SERVER_VERSION=9.0.0-rc.8 bun ./node_modules/.bin/npm-midnight-proof-server --docker --port ${BRIDGE_CONTRACT_PROOF_SERVER_PORT:-6301}",
    "midnight-contract-prover:wait": "bun run scripts/wait-contract-prover.ts",
    "midnight-contract:deploy": "bash scripts/compile.sh && bun run deploy.ts --mode local"
  },
  "dependencies": {
    "@effectstream/midnight-contracts": "0.200.6",
    "@effectstream/npm-midnight-indexer": "0.200.6",
    "@effectstream/npm-midnight-node": "0.200.6",
    "@effectstream/npm-midnight-proof-server": "0.200.6",
    "@midnight-ntwrk/compact-js": "2.5.5-rc.7",
    "@midnight-ntwrk/compact-runtime": "0.18.0-rc.1",
    "@midnight-ntwrk/compact-runtime-0.20": "npm:@midnight-ntwrk/compact-runtime@0.20.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0-beta.6",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-beta.6",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-beta.6",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-beta.6",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0-beta.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-hd": "3.1.0-beta.1",
    "@noble/curves": "^2.2.0",
    "@solana-midnight-bridge/contracts-solana": "workspace:*",
    "@solana/web3.js": "^1.95.0",
    "rxjs": "^7.8.2",
    "tweetnacl": "^1.0.3",
    "wait-on": "8.0.3"
  }
}
