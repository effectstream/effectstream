{
  "name": "solana-midnight-bridge",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "NODE_ENV=development bunx orchestrator start",
    "live": "bunx orchestrator start start.live.ts",
    "test": "bun run packages/tests/run-tests.ts",
    "build:solana": "bun run --filter @solana-midnight-bridge/contracts-solana build",
    "build:solana:program": "bun run --filter @solana-midnight-bridge/contracts-solana build:program",
    "init:local": "bun run --filter @solana-midnight-bridge/contracts-solana init:local",
    "deploy:devnet": "bun run --filter @solana-midnight-bridge/contracts-solana deploy:devnet"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@effectstream/orchestrator": "0.200.6",
    "wait-on": "8.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  },
  "effectstream": {
    "default": "start.dev.ts"
  },
  "overrides": {
    "@effect/platform": "0.96.1",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0-beta.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-capabilities": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-hd": "3.1.0-beta.1",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0-beta.2"
  }
}
