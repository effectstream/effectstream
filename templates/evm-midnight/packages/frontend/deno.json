{
  "name": "@example-evm-midnight/frontend",
  "version": "0.3.22",
  "license": "MIT",
  "exports": {
    ".": "./server/main.ts"
  },
  "tasks": {
    "dev": "deno run -A --node-modules-dir=auto npm:vite --port 10598",
    "build": "deno run -A --node-modules-dir=auto npm:vite build",
    "server:start": "deno run -A --node-modules-dir --watch ./server/main.ts",
    "serve": "deno task build && deno task server:start"
  },
  "imports": {
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.4",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.4",
    "@midnight-ntwrk/onchain-runtime": "npm:@midnight-ntwrk/onchain-runtime@^0.3.0",
    "@oak/oak": "jsr:@oak/oak@^17.1.4",
    "@paimaexample/concise": "jsr:@paimaexample/concise@0.3.73",
    "@paimaexample/utils": "jsr:@paimaexample/utils@0.3.73",
    "@paimaexample/wallets": "jsr:@paimaexample/wallets@0.3.73",
    "@paimaexample/event-client": "jsr:@paimaexample/event-client@0.3.73",
    "@std/assert": "jsr:@std/assert@^1.0.12",
    "@types/react": "npm:@types/react@^19.1.2",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.4.1",
    "react": "npm:react@19.1.0",
    "react-dom": "npm:react-dom@19.1.0",
    "react-router-dom": "npm:react-router-dom@^7.5.1",
    "rxjs": "npm:rxjs@^7.8.2",
    "stream-browserify": "npm:stream-browserify@3.0.0",
    "vite": "npm:vite@^7.1.3",
    "viem": "npm:viem@2.37.3",
    "viem/accounts": "npm:viem/accounts",
    "viem/chains": "npm:viem/chains",
    "vite-plugin-node-stdlib-browser": "npm:vite-plugin-node-stdlib-browser",
    "vite-plugin-static-copy": "npm:vite-plugin-static-copy@^3.1.1",
    "vite-plugin-top-level-await": "npm:vite-plugin-top-level-await@^1.6.0",
    "vite-plugin-wasm": "npm:vite-plugin-wasm@^3.5.0",
    "ws": "npm:ws@^8.18.3",
    "@thirdweb-dev/chains": "npm:@thirdweb-dev/chains@0.1.63",
    "@thirdweb-dev/wallets": "npm:@thirdweb-dev/wallets@2.4.1",
    "ethers": "npm:ethers@5.7.2"
  },
  "compilerOptions": {
    "types": [
      "react",
      "react-dom",
      "@types/react"
    ],
    "lib": [
      "dom",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "types": [
    "vite/client"
  ]
}