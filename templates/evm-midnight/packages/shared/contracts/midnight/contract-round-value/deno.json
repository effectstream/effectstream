{
  "name": "@example/my-midnight-contract",
  "exports": {
    ".": "./src/_index.ts",
    "./witnesses": "./src/witnesses.ts"
  },
  "tasks": {
    "compact": "compact compile src/counter.compact src/managed/counter && deno task convert:js",
    "convert:js": "deno run -A convert-js.ts src/managed/counter/contract-round-value/index.cjs src/managed/counter/contract-round-value/index.ts",
    "contract:compile": "deno task compact"
  },
  "imports": {
    "vitest": "npm:vitest@^3.2.4",
    "@example/my-midnight-contract": "@example/my-midnight-contract"
  }
}