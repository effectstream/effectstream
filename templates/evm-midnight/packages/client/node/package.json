{
  "name": "@example-evm-midnight/node",
  "version": "0.3.22",
  "license": "MIT",
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "check": "tsc --noEmit src/main.ts",
    "node:start": "bun --inspect run src/main.ts",
    "node:start:testnet": "bun --inspect run src/main.testnet.ts",
    "dev": "bun run --filter @paimaexample/tui clean && NODE_ENV=development bun run scripts/start.ts",
    "testnet": "bun run --filter @paimaexample/tui clean && EFFECTSTREAM_ENV=testnet bun run scripts/start.testnet.ts",
    "test": "bun run scripts/e2e.test.ts"
  },
  "dependencies": {
    "@paimaexample/concise": "0.3.129",
    "@paimaexample/config": "0.3.129",
    "@paimaexample/log": "0.3.129",
    "@paimaexample/orchestrator": "0.3.129",
    "@paimaexample/runtime": "0.3.129",
    "@paimaexample/tui": "0.3.129",
    "@paimaexample/utils": "0.3.129",
    "@paimaexample/sm": "0.3.129",
    "@paimaexample/coroutine": "0.3.129",
    "@paimaexample/db": "0.3.129",
    "@paimaexample/explorer": "0.3.129",
    "node-gyp": "^10.3.0",
    "fastify": "^5.4.0",
    "pg": "^8.14.0",
    "@sinclair/typebox": "0.34.41",
    "effection": "^3.5.0",
    "http-server": "^14.1.1",
    "@midnight-ntwrk/onchain-runtime": "npm:@midnight-ntwrk/onchain-runtime-v1@1.0.0-alpha.5"
  }
}