{
  "workspace": [
    "./packages/**/*"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "build:evm": "deno task -f @example/evm-contracts build && deno task -f @example/evm-contracts deploy:standalone",
    "build:midnight": "deno task -f  @example/my-midnight-contract compact",
    "dev": "deno task -f @example/node dev",
    "start:frontend": "deno task -f @example/frontend dev",
    "check": "deno check"
  },
  "imports": {
    // TODO: This is a workaround for a missing dependency.
    "@paimaexample/tui": "jsr:@paimaexample/tui@0.3.28"
  },
  "lint": {
    "rules": {
      "exclude": [
        // needed for generators since you can't use the arrow function syntax
        "no-this-alias",
        // this is too strict to play well with effection
        "require-yield",
        // way too many typescript things that require using `any`
        "no-explicit-any",
        "ban-types", // `Function` and `{}` are occasionally useful
        "no-unused-vars", // maybe enable this at some point
        "no-slow-types" // would be nice to have, but this is a lot of work
      ]
    }
  }
}