{
  "name": "@zk-cardano/contracts-cardano",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": "./cardano-tx-helpers.ts",
  "scripts": {
    "devkit:start": "bunx @bloxbean/yaci-devkit up",
    "devkit:wait": "wait-on tcp:3001",
    "dolos:fill-template": "bun ./fill-template.ts",
    "dolos:start": "rm -rf ./data ./dolos.socket && bun ./node_modules/.bin/dolos bootstrap relay && bun ./node_modules/.bin/dolos daemon",
    "dolos:wait": "wait-on tcp:50051",
    "cardano-submit-tx": "bun ./submit-tx.ts"
  },
  "dependencies": {
    "@txpipe/dolos": "1.2.0",
    "@lucid-evolution/lucid": "^0.4.29",
    "@lucid-evolution/provider": "^0.1.91",
    "@lucid-evolution/utils": "^0.1.66",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@bloxbean/yaci-devkit": "*",
    "wait-on": "8.0.3"
  }
}
