{
  "private": true,
  "workspaces": ["packages/*", "packages/contracts-midnight/contract-ballot"],
  "scripts": {
    "dev": "NODE_ENV=development bunx orchestrator start",
    "test": "bun run packages/tests/run-tests.ts",
    "build:midnight": "bun run --filter @zk-cardano/midnight-contract compact",
    "build:pgtypes": "bun run --filter @zk-cardano/database pgtyped:update"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@effectstream/midnight-contracts": "0.200.1",

    "@effectstream/orchestrator": "0.200.1",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2",
    "wait-on": "8.0.3"
  },
  "effectstream": {
    "default": "start.dev.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13"
  }
}
