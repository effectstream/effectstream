{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "jsx": "react-jsx",
    "types": ["bun-types"]
  },
  "exclude": [
    "node_modules",
    "templates"
  ]
}
