{
  "name": "@effectstream/db",
  "version": "0.3.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./start-pglite": "./scripts/start-pglite.ts",
    "./apply-migrations": "./scripts/apply-migrations.ts",
    "./db-up": "./scripts/start-pglite.ts",
    "./db-wait": "./scripts/wait-for-db.ts",
    "./pgtyped-update": "./scripts/pgtyped-update.ts",
    "./version": "./migrations/system-version.ts"
  },
  "tasks": {
    "pgtyped:update": "deno task _build:assets && ((kill -9 $(lsof -ti:5432)) || true) && deno run -A @effectstream/db/pgtyped-update",
    "_build:assets": "(rm migrations/assets.ts || true) && deno run --allow-read jsr:@codemonument/asset-builder --import-file assets-config.json > ./migrations/assets.ts"
  },
  "imports": {
    "@pgtyped/runtime": "npm:@pgtyped/runtime@2.4.2",
    "@pgtyped/parser": "npm:@pgtyped/parser@2.4.2",
    "pg": "npm:pg@8.17.2",
    "pg-tx": "npm:pg-tx@^1.0.1",
    "effection": "npm:effection@^3.5.0",
    // note: in `package.json` we fork @pgtyped/cli because of https://github.com/adelsz/pgtyped/pull/595
    "pg-gateway": "^0.3.0-beta.4"
  }
}