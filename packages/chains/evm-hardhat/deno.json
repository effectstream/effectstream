{
    "name": "@effectstream/evm-hardhat",
    "version": "0.3.0",
    "license": "MIT",
    "tasks": {
        "build:assets": "deno run --allow-read jsr:@codemonument/asset-builder --import-file ./src/remappings/assets-config.json > ./src/remappings/assets.ts"
    },
    "imports": {
        "@std/cli": "jsr:@std/cli@^1.0.24",
        "@std/path": "jsr:@std/path@^1.1.3",
        "ws": "npm:ws@8.18.1",
        "hardhat": "npm:hardhat@3.0.4",
        "@nomicfoundation/hardhat-ignition": "npm:@nomicfoundation/hardhat-ignition-viem@3.0.2",
        "@nomicfoundation/hardhat-ignition-viem": "npm:@nomicfoundation/hardhat-ignition-viem@3.0.2",
        "@nomicfoundation/hardhat-viem": "npm:@nomicfoundation/hardhat-viem@3.0.0",
        "@nomicfoundation/hardhat-errors": "npm:@nomicfoundation/hardhat-errors@3.0.1",
        "@nomicfoundation/hardhat-utils": "npm:@nomicfoundation/hardhat-utils@3.0.0",
        "@paimaexample/log": "jsr:@paimaexample/log@0.3.126",
        "jsonc-parser": "npm:jsonc-parser@^3.3.1",
        "@opentelemetry/sdk-node": "npm:@opentelemetry/sdk-node@0.56.0"
    },
    "exports": {
        "./json-rpc-server": "./src/json-rpc-server/json-rpc/server.ts",
        "./builder": "./src/builder/build.mod.ts",
        "./remappings-hardhat": "./src/remappings/remappings-hardhat.ts",
        "./remappings-forge": "./src/remappings/remappings-forge.ts",
        // "./scaffold": "./src/scaffold/mod.ts",
        "./hardhat-config-builder": "./src/hardhatConfigBuilder.ts"
    },
    "tasks": {
        "scaffold": "deno run -A ./src/scaffold/scaffold-evm.ts"
    }
}   