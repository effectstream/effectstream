{
  "name": "@effectstream/explorer",
  "version": "0.3.0",
  "main": "client/dist/index.html",
  "exports": {
    ".": "./server/main.ts"
  },
  "bin": {
    "explorer": "cli.cjs"
  },
  "files": [
    "cli.cjs",
    "client/dist/index.html",
    "client/dist/**",
    "server/**"
  ],
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "server:start": "bun --watch ./server/main.ts",
    "serve": "bun run build && bun run server:start"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "@fastify/static": "^8.1.0",
    "http-server": "^14.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.5.1",
    "viem": "2.37.3"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "7.1.3",
    "vite-plugin-node-stdlib-browser": "*"
  }
}
