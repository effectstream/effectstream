# Dashboard process only. Point this at the same local EffectStream PostgreSQL
# database used by the runtime; the live acceptance runner configures this
# connection automatically for its disposable cluster.
DATABASE_URL=postgresql://effectstream:effectstream@127.0.0.1:5432/effectstream
DASHBOARD_CKB_RPC_URL=http://127.0.0.1:8114
DASHBOARD_EVM_RPC_URL=http://127.0.0.1:8545
DASHBOARD_CKB_PROTOCOL=ckbRelayEvents
DASHBOARD_PORT=4173
