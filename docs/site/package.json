{
  "name": "@effectstream/docs",
  "version": "0.3.0",
  "scripts": {
    "sync-readmes": "bun run scripts/sync-package-readmes.ts && bun run scripts/sync-template-readmes.ts",
    "sync-readmes:check": "bun run scripts/sync-package-readmes.ts --check && bun run scripts/sync-template-readmes.ts --check",
    "start": "bun run sync-readmes && docusaurus start",
    "build": "bun run sync-readmes && docusaurus build",
    "docs:check": "bun run sync-readmes:check"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.0",
    "@docusaurus/preset-classic": "3.10.0",
    "@docusaurus/theme-mermaid": "3.10.0",
    "@docusaurus/plugin-client-redirects": "3.10.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "docusaurus-plugin-remote-content": "^4.0.0",
    "rehype-katex": "^7.0.0",
    "remark-math": "^6.0.0",
    "@easyops-cn/docusaurus-search-local": "^0.44.2",
    "@docusaurus/theme-common": "3.10.0",
    "mermaid": "^11.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.0",
    "@docusaurus/tsconfig": "3.10.0",
    "@docusaurus/types": "3.10.0",
    "typescript": "~5.6.2",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}